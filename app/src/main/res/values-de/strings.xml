    <string name="set_accent">Akzentfarbe</string>
    <string name="set_accent_help">Färbt Fokusring, fokussierte Taste und die Markierung installierter Apps. OK drücken um die nächste zu versuchen.</string>
    <string name="set_appearance">Aussehen</string>
    <string name="set_appearance_help">Hell nutzt eine weißen Hintergrund, Dunkel einen anthrazitfarbenen für Abende. System folgt der Einstellung des TVs. Drücke OK zum Wechseln.</string>
    <string name="set_install">Installiere Apps von Open Shelf</string>
    <string name="allowed">Erlaubt</string>
    <string name="not_allowed">Noch nicht erlaubt</string>
    <string name="set_install_help">Android fragt einmal nach Erlaubnis. Danach kann Open Shelf Apps Installieren und Aktualisieren. Jede Installation erfordert noch eine Bestätigung.</string>
    <string name="set_apk">APK-Typ</string>
    <string name="apk_auto">Automatisch · %1$s</string>
    <string name="set_apk_help">Viele Apps veröffentlichen für jeden Chiptyp eine andere Datei. Open Shelf wählt das zum TV passende Format aus. Hier unterstützt: %1$s.</string>
    <string name="set_key">Wenn sich ein App-Signaturschlüssel ändert</string>
    <string name="set_key_value">Das Update anhalten</string>
    <string name="set_key_help">Jede Veröffentlichung wird vom Entwickler signiert. Wenn eine neue Datei eine andere Signatur hat behält Open Shelf die aktuelle Version und installiert sie nicht.</string>
    <string name="set_catalog">Katalog</string>
    <string name="catalog_value">%1$s Apps · %2$s</string>
    <string name="catalog_help">Jede Android TV-App auf GitHub die in den letzten 3 Jahren eine APK veröffentlicht hat. Geprüft am %1$s. Diese Version enthält die Liste in der App.</string>
    <string name="set_stars">Apps mit weniger Sternen als ausblenden</string>
    <string name="set_stars_help">Hält sehr neue oder wenig genutzte Apps aus "Entdecken" fern. %1$s Apps sind ausgeblendet. Die Suche findet sie immer noch anhand ihres genauen Namens.</string>
    <string name="set_streams">IPTV und Streaming-Apps ausblenden</string>
    <string name="streams_on">An · %1$s ausgeblendet</string>
    <string name="streams_off">Aus</string>
    <string name="set_streams_help">Versteckt IPTV-Player, Live-TV-Kanal-Apps und Debrid-, Torrent- oder Stremio-Streaming-Clients. Sie sind Open Source und spielen Streams ab die du selbst mitbringst. Drücke OK zum wechseln.</string>
    <string name="set_cache">Download-Cache</string>
    <string name="cache_value">%1$s · Bereinigen</string>
    <string name="set_cache_help">Heruntergeladene APK-Dateien werden hier gespeichert damit sie ohne erneuten Download installiert werden können. Drücke OK um sie zu löschen.</string>
    <string name="set_about">Über</string>
    <string name="about_value">Open Shelf %1$s</string>
    <string name="about_help">Open Shelf ist Open Source (GPL-3.0) verfügbar auf github.com/wingedpanther/openshelf. App-Namen, Grafiken und Veröffentlichungen stammen aus den GitHub-Repositorys der Projekte.</string>
